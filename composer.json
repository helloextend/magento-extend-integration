{
  "name": "helloextend/integration",
  "description": "A Magento module to sell product and shipping protection in your store to increase revenues and drive customer loyalty.",
  "require": {
    "php": "^7.4||^8.0||^8.1||^8.2||^8.3||^8.4",
    "magento/module-integration": "^100.4.2"
  },
  "suggest": {},
  "type": "magento2-module",
  "license": "Apache-2.0",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Extend\\Integration\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
